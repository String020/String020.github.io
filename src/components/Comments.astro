---
import { site } from "../data/site";

type Props = {
  term: string;
  autoload?: boolean;
};

const { term, autoload = false } = Astro.props;
const { repo, repoId, category, categoryId } = site.comments;
// Giscus loads custom themes by absolute URL from inside its iframe.
const themeUrl = (mode: "light" | "dark") =>
  new URL(`${import.meta.env.BASE_URL}giscus/${mode}.css`, Astro.site ?? Astro.url).href;
---

<section
  class="comments"
  aria-label="Comments"
  data-comments
  data-comments-autoload={autoload ? "" : undefined}
  data-repo={repo}
  data-repo-id={repoId}
  data-category={category}
  data-category-id={categoryId}
  data-term={term}
  data-theme-light={themeUrl("light")}
  data-theme-dark={themeUrl("dark")}
>
  <h2>Comments</h2>
</section>
