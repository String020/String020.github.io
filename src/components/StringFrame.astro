---
// The string frame for pages outside the portal: bands, a written title, and the way home.
import { portalContent } from "../lib/portal-content";
import { stageVersion } from "../lib/stage";

type Props = { title: string };
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = portalContent.navigation.map(({ id, slug, label, title, kind }) => ({ id, slug, label, title, kind }));
const data = JSON.stringify({ navigation }).replace(/</g, "\\u003c");
---

<div class="string-band-hit" aria-hidden="true"></div>
<div class="string-band-hit is-bottom" aria-hidden="true"></div>
<canvas class="string-stage" data-string-stage data-title={title} data-base={base} aria-hidden="true"></canvas>
<script type="application/json" id="portal-content-data" set:html={data} />
<script is:inline src={`${base}assets/string-stage.js?v=${stageVersion}`}></script>
