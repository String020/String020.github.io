---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import profilePhoto from "../assets/profile-photo.jpg";
import ManagedCardGrid from "./ManagedCardGrid.astro";
import Comments from "./Comments.astro";
import CommentsScript from "./CommentsScript.astro";
import RichContent from "./RichContent.astro";
import ThemeInit from "./ThemeInit.astro";
import { site } from "../data/site";
import {
  formatDate,
  getAdjacentPosts,
  getAllCategories,
  getAllSeries,
  getAllTags,
  getCategory,
  getImageUrl,
  getReadingStats,
  getSeries,
  isPublished,
  slugifyTaxonomy,
  sortPosts,
  sortPostsByDateOnly,
} from "../lib/blog";
import { backgroundStyle } from "../lib/images";
import { managedNavigation, portalContent } from "../lib/portal-content";
import "../styles/global.css";
import "../styles/blog-features.css";

type Props = {
  /** Portal route to open on load, e.g. "", "blog/", "skills/" or "blog/first-post/". */
  route?: string;
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  lang?: string;
  /** Post whose body is passed in the "article" slot and rendered on the server. */
  articleId?: string;
  /** Renders the 404 panel, which opens for any address without a portal route. */
  notFound?: boolean;
};

const {
  route = "",
  title,
  description = site.description,
  image,
  ogType = "website",
  publishedTime,
  lang = "zh-CN",
  articleId,
  notFound = false,
} = Astro.props;
const articleHtml = articleId && Astro.slots.has("article") ? await Astro.slots.render("article") : "";

const blogPosts = sortPosts((await getCollection("blog")).filter(isPublished));
const postsByDate = sortPostsByDateOnly(blogPosts);
const blogCategories = getAllCategories(blogPosts);
const blogSeries = getAllSeries(blogPosts);
const blogTags = getAllTags(blogPosts);

const base = import.meta.env.BASE_URL;
const withBase = (path = "") => `${base}${path.replace(/^\/+/, "")}`;
const isExternal = (href: string) => /^(https?:|mailto:|#)/.test(href);
const linkHref = (href: string) => (isExternal(href) ? href : withBase(href));
const tagHref = (tag: string) =>
  ({
    Blog: "blog/",
    Archives: "archives/",
    My: "my/",
    About: "about/",
    Projects: "projects/",
    Study: "blog/tag/notes/",
  })[tag] ?? `search/?q=${encodeURIComponent(tag)}`;
const canonicalUrl = Astro.site && !notFound ? new URL(Astro.url.pathname, Astro.site) : null;
const pageTitle = title ? `${title} | ${site.brand.name}` : site.title;
const shareImage = image ? new URL(image, Astro.site ?? Astro.url) : null;
const navigation = portalContent.navigation;
const tabIndexByNavigationId = new Map(navigation.map((item, index) => [item.id, index]));
const blogTabIndex = tabIndexByNavigationId.get("blog");

// Panels in DOM order, so the requested route can be opened in the server-rendered HTML.
const panelOrder = [
  { route: "", tab: 0 },
  { route: "blog/", tab: blogTabIndex },
  ...managedNavigation.map((item) => ({ route: `${item.slug}/`, tab: tabIndexByNavigationId.get(item.id) })),
  ...portalContent.pages.map((page) => ({
    route: `${page.route}/`,
    tab: tabIndexByNavigationId.get(page.parentNavigationId),
  })),
  ...blogPosts.map((post) => ({ route: `blog/${post.id}/`, tab: blogTabIndex })),
  { route: "search/", tab: undefined },
];
// The 404 panel has no route of its own; it is keyed internally so it can be opened on load.
const notFoundKey = "#not-found";
if (notFound) panelOrder.push({ route: notFoundKey, tab: undefined });
const activeRoute = notFound ? notFoundKey : route;
const pageCount = panelOrder.length;
const initialIndex = Math.max(0, panelOrder.findIndex((panel) => panel.route === activeRoute));
const initialTab = panelOrder[initialIndex].tab;
const panelState = (panelRoute: string) => {
  const isCurrent = panelOrder[initialIndex].route === panelRoute;
  return { class: isCurrent ? "is-current" : "", inert: !isCurrent };
};
const editorScriptUrl = withBase("assets/portal-editor.js");
const adminApiUrl = import.meta.env.PUBLIC_ADMIN_API_URL || "";
const serializedPortalContent = JSON.stringify(portalContent).replace(/</g, "\\u003c");
const statCounts: Record<string, number> = {
  "Main sections": navigation.length,
  "Blog posts": blogPosts.length,
  "About routes": portalContent.pages.filter((page) => page.parentNavigationId === "about").length,
  "Future lab": site.lab.items.length,
};
const dashboardStats = site.dashboard.stats.map((stat) =>
  stat.label in statCounts ? { ...stat, value: String(statCounts[stat.label]).padStart(2, "0") } : stat,
);
const categories = Array.from(new Set(blogPosts.map((post) => post.data.category).filter(Boolean)));
const tagCounts = blogPosts.reduce((counts, post) => {
  post.data.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1));
  return counts;
}, new Map<string, number>());
const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <ThemeInit />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {notFound && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
  </head>
  <body style={backgroundStyle} data-admin-api={adminApiUrl} data-portal-base={base} data-editor-src={editorScriptUrl} data-initial-panel={notFound ? "not-found" : undefined}>
    <div class="backdrop" aria-hidden="true"></div>
    <div class="soft-wash" aria-hidden="true"></div>

    <header class="portal-header">
      <a class="portal-brand" href={withBase()} aria-label="Portal home">
        <span class="brand-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M12 2.8 20 6.2v5.9c0 4.8-3.4 7.8-8 9.1-4.6-1.3-8-4.3-8-9.1V6.2l8-3.4Z"></path>
            <path d="M8.4 10.4 12 7.8l3.6 2.6-1.4 4.2H9.8l-1.4-4.2Z"></path>
          </svg>
        </span>
        <span>{site.brand.name}</span>
      </a>

      <nav class="tabs" aria-label="Portal pages">
        {
          navigation.map((item, index) => (
            <button
              class={`tab ${index === initialTab ? "is-active" : ""}`}
              type="button"
              data-page={index}
              data-navigation-tab
              data-navigation-id={item.id}
              data-navigation-locked={String(item.locked)}
            >
              {item.label}
            </button>
          ))
        }
        <button class="tool-button compact editor-entry" type="button" aria-label="Enter edit mode" data-editor-toggle hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h9"></path>
            <path d="M17 7h3"></path>
            <path d="M15 5v4"></path>
            <path d="M4 17h3"></path>
            <path d="M11 17h9"></path>
            <path d="M9 15v4"></path>
          </svg>
        </button>
      </nav>

      <div class="header-actions" aria-label="Header actions">
        <a class="search-pill" href={withBase("search/")} aria-label="Search blog">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m20 20-4.3-4.3"></path>
            <circle cx="10.8" cy="10.8" r="6.2"></circle>
          </svg>
          <span>Search blog</span>
        </a>
        <div class="lab-menu" data-lab-menu>
          <button
            class="tool-button dot-grid"
            type="button"
            aria-label="Open lab menu"
            aria-expanded="false"
            aria-controls="lab-menu-panel"
            data-lab-menu-toggle
          >
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
          </button>
          <div class="lab-menu-panel" id="lab-menu-panel" aria-label="Lab menu" data-lab-menu-panel hidden>
            <div class="lab-menu-heading">
              <strong>{site.lab.eyebrow}</strong>
              <small>功能菜单</small>
            </div>
            <ul class="lab-menu-tree" aria-label="Lab features">
              {
                site.lab.items.map((item, index) => (
                  <li class="lab-tree-item" data-lab-tree-item>
                    <button
                      class="lab-tree-trigger"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`lab-tree-branch-${index}`}
                      data-lab-tree-trigger
                    >
                      <span class="lab-tree-marker" aria-hidden="true"></span>
                      <span>{item}</span>
                      <span class="lab-tree-chevron" aria-hidden="true">›</span>
                    </button>
                    <div class="lab-tree-branch" id={`lab-tree-branch-${index}`} data-lab-tree-branch hidden>
                      <button class="lab-branch-back" type="button" data-lab-branch-back>
                        <span aria-hidden="true">‹</span>
                        <strong>{item}</strong>
                      </button>
                      <p>等待开发</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <a class="tool-button" href={withBase("contact/")} aria-label="Open contact links">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5.4 6.2h13.2a2 2 0 0 1 2 2v6.5a2 2 0 0 1-2 2h-6.1l-4.1 3v-3h-3a2 2 0 0 1-2-2V8.2a2 2 0 0 1 2-2Z"></path>
            <path d="M8 10.3h8"></path>
            <path d="M8 13.2h5.6"></path>
          </svg>
        </a>
        <a class="tool-button" href={withBase("about/")} aria-label="Open profile">
          <span>{site.brand.initials}</span>
        </a>
        <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-toggle>
          <span class="theme-toggle-knob" aria-hidden="true">
            <svg class="theme-toggle-sun" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path>
            </svg>
            <svg class="theme-toggle-moon" viewBox="0 0 24 24">
              <path d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.8 7.8 0 1 0 10.1 10.1Z"></path>
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main class="app-shell">
      <aside class="profile-column" aria-label="Profile panel">
        <section class="profile-card panel">
          <a class="avatar avatar-link" href={withBase("about/")} aria-label="Open about page">
            <Image
              src={profilePhoto}
              alt="String profile photo"
              width={640}
              widths={[320, 640]}
              sizes="(max-width: 980px) 40vw, 240px"
              loading="eager"
            />
          </a>
          <h1>{site.profile.name}</h1>
          <p>{site.profile.summary}</p>
          <div class="quick-links" aria-label="Quick links">
            {site.profile.links.map((link) => <a href={linkHref(link.href)}>{link.label}</a>)}
          </div>
        </section>

        <section class="mini-card panel">
          <div class="mini-title">
            <span></span>
            Notice
          </div>
          <p>{site.profile.notice}</p>
        </section>

        <section class="mini-card panel">
          <div class="mini-title">
            <span></span>
            Tags
          </div>
          <div class="tag-cloud">
            {site.profile.tags.map((tag) => <a href={linkHref(tagHref(tag))}>{tag}</a>)}
          </div>
        </section>
      </aside>

      <section class="content-stage panel" aria-live="polite">
        <div
          class="slide-track"
          data-track
          style={`--page-count: ${pageCount}; transform: translateX(calc(-${initialIndex} * 100% / ${pageCount}))`}
        >
          <article class={`page ${panelState("").class}`} inert={panelState("").inert} data-panel="home" data-route="">
            <div class="page-heading">
              <p>{site.dashboard.eyebrow}</p>
              <h2>{site.dashboard.title}</h2>
            </div>
            <div class="summary-row">
              {
                dashboardStats.map((stat, index) => (
                  <div class={`stat tone-${["a", "b", "c", "d"][index % 4]}`}>
                    <strong>{stat.value}</strong>
                    <span>{stat.label}</span>
                  </div>
                ))
              }
            </div>
            <div class="home-grid">
              <section class="focus-panel">
                <h3>{site.dashboard.focus.title}</h3>
                <p>{site.dashboard.focus.text}</p>
                <div class="progress-line">
                  <span style={`width: ${site.dashboard.focus.progress}%`}></span>
                </div>
              </section>
              <section class="todo-panel">
                <h3>Next edits</h3>
                <ul>
                  {site.dashboard.today.map((item) => <li>{item}</li>)}
                </ul>
              </section>
              <section class="music-panel" aria-label="Now playing">
                <div>
                  <span>Music</span>
                  <h3>Now playing</h3>
                </div>
                <iframe
                  title="NetEase Cloud Music player"
                  width="330"
                  height="86"
                  src="https://music.163.com/outchain/player?type=2&id=1909742217&auto=0&height=66"
                  loading="lazy"
                ></iframe>
              </section>
            </div>
          </article>

          <article
            class={`page blog-panel ${panelState("blog/").class}`}
            inert={panelState("blog/").inert}
            data-panel="blog"
            data-route="blog/"
            data-tab={blogTabIndex}
          >
            <div class="page-heading">
              <p>{site.blog.eyebrow}</p>
              <h2>{site.blog.title}</h2>
            </div>
            <p class="page-intro">{site.blog.intro}</p>
            <nav class="blog-tools" aria-label="Blog tools">
              {site.blog.actions.map((action) => <a class="tool-link" href={linkHref(action.href)}>{action.label}</a>)}
            </nav>

            {blogCategories.length > 0 && (
              <section class="taxonomy-block" aria-label="Categories">
                <h2>Categories</h2>
                <div class="taxonomy-cloud">
                  {blogCategories.map((category) => (
                    <a class="taxonomy-link" href={withBase(`blog/category/${slugifyTaxonomy(category)}/`)}>{category}</a>
                  ))}
                </div>
              </section>
            )}

            {blogSeries.length > 0 && (
              <section class="taxonomy-block" aria-label="Series">
                <h2>Series</h2>
                <div class="taxonomy-cloud">
                  {blogSeries.map((series) => (
                    <a class="taxonomy-link" href={withBase(`blog/series/${slugifyTaxonomy(series)}/`)}>{series}</a>
                  ))}
                </div>
              </section>
            )}

            {blogTags.length > 0 && (
              <section class="taxonomy-block" aria-label="Tags">
                <h2>Tags</h2>
                <div class="taxonomy-cloud">
                  {blogTags.map((tag) => (
                    <a class="taxonomy-link" href={withBase(`blog/tag/${slugifyTaxonomy(tag)}/`)}>#{tag}</a>
                  ))}
                </div>
              </section>
            )}

            <section class="blog-list" aria-label="Blog posts">
              {
                blogPosts.map((post) => {
                  const category = getCategory(post);
                  const series = getSeries(post);
                  const cover = getImageUrl(post, withBase);
                  return (
                    <article class={`blog-row ${cover ? "has-cover" : ""}`}>
                      {cover && (
                        <a class="post-cover" href={withBase(`blog/${post.id}/`)} aria-label={post.data.title}>
                          <img src={cover} alt="" loading="lazy" />
                        </a>
                      )}
                      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                      <div>
                        <div class="post-meta-line">
                          {post.data.pinned && <span class="pinned-badge">Pinned</span>}
                          <a class="post-category" href={withBase(`blog/category/${slugifyTaxonomy(category)}/`)}>{category}</a>
                          {series && <a class="meta-pill" href={withBase(`blog/series/${slugifyTaxonomy(series)}/`)}>{series}</a>}
                          <span class="meta-pill">{getReadingStats(post).label}</span>
                        </div>
                        <a class="post-title-link" href={withBase(`blog/${post.id}/`)}>
                          <h2>{post.data.title}</h2>
                        </a>
                        <p>{post.data.description}</p>
                        <div class="post-tags">
                          {post.data.tags.map((tag) => (
                            <a href={withBase(`blog/tag/${slugifyTaxonomy(tag)}/`)}>#{tag}</a>
                          ))}
                        </div>
                      </div>
                    </article>
                  );
                })
              }
            </section>
          </article>

          {
            managedNavigation.map((navigationItem) => (
              <article
                class={`page managed-navigation-page ${panelState(`${navigationItem.slug}/`).class}`}
                inert={panelState(`${navigationItem.slug}/`).inert}
                data-panel={navigationItem.id}
                data-route={`${navigationItem.slug}/`}
                data-tab={tabIndexByNavigationId.get(navigationItem.id)}
                data-navigation-panel
                data-navigation-id={navigationItem.id}
              >
                <div class="page-heading">
                  <p>Navigation</p>
                  <h2 data-navigation-title>{navigationItem.title}</h2>
                </div>
                <p class="page-intro" data-navigation-description>{navigationItem.description}</p>
                <ManagedCardGrid
                  blocks={navigationItem.blocks}
                  pages={portalContent.pages}
                  base={base}
                  navigationId={navigationItem.id}
                />
                {navigationItem.id === "archives" && (
                  <div class="metadata-row">
                    <a href={withBase("blog/")}>{categories.length || 0} categories</a>
                    <a href={withBase("blog/")}>{topTags.length || 0} active tags</a>
                    <a href={withBase("blog/archive/")}>{blogPosts.length} published posts</a>
                  </div>
                )}
              </article>
            ))
          }

          {
            portalContent.pages.map((managedPage) => (
              <article
                class={`page detail-page managed-detail-page ${panelState(`${managedPage.route}/`).class}`}
                inert={panelState(`${managedPage.route}/`).inert}
                data-panel={`managed-${managedPage.id}`}
                data-route={`${managedPage.route}/`}
                data-tab={tabIndexByNavigationId.get(managedPage.parentNavigationId)}
                data-managed-page
                data-page-id={managedPage.id}
              >
                <a
                  class="panel-back"
                  href={withBase(`${portalContent.navigation.find((item) => item.id === managedPage.parentNavigationId)?.slug || ""}/`)}
                  data-portal-route={`${portalContent.navigation.find((item) => item.id === managedPage.parentNavigationId)?.slug || ""}/`}
                >
                  Back to {portalContent.navigation.find((item) => item.id === managedPage.parentNavigationId)?.title || "dashboard"}
                </a>
                <header class="section-header">
                  <p>{portalContent.navigation.find((item) => item.id === managedPage.parentNavigationId)?.title || "Page"}</p>
                  <div><span class="section-badge" data-managed-page-badge>{managedPage.badge}</span></div>
                  <h1 data-managed-page-title>{managedPage.title}</h1>
                  <span data-managed-page-description>{managedPage.description}</span>
                </header>
                <RichContent blocks={managedPage.content} base={base} />
              </article>
            ))
          }

          {
            blogPosts.map((post) => {
              const postRoute = `blog/${post.id}/`;
              const category = getCategory(post);
              const series = getSeries(post);
              const cover = getImageUrl(post, withBase);
              const { previous, next } = getAdjacentPosts(postsByDate, post);
              const isServerRendered = post.id === articleId && articleHtml;
              return (
                <article
                  class={`page detail-page article-panel ${panelState(postRoute).class}`}
                  inert={panelState(postRoute).inert}
                  data-panel={`post-${post.id}`}
                  data-route={postRoute}
                  data-tab={blogTabIndex}
                >
                  <a class="panel-back" href={withBase("blog/")} data-portal-route="blog/">Back to blog</a>
                  <div class="article-layout">
                    <div class="article-card" data-pagefind-body={isServerRendered ? "" : undefined}>
                      <header class="article-header">
                        {cover && <img class="article-cover" src={cover} alt="" />}
                        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                        <h1>{post.data.title}</h1>
                        <p>{post.data.description}</p>
                        <div class="article-meta">
                          <a
                            class="meta-pill"
                            href={withBase(`blog/category/${slugifyTaxonomy(category)}/`)}
                            data-pagefind-meta={isServerRendered ? "category" : undefined}
                          >
                            {category}
                          </a>
                          {series && <a class="meta-pill" href={withBase(`blog/series/${slugifyTaxonomy(series)}/`)}>{series}</a>}
                          <span class="meta-pill" data-pagefind-meta={isServerRendered ? "reading" : undefined}>
                            {getReadingStats(post).label}
                          </span>
                          {post.data.updated && <span class="meta-pill">Updated {formatDate(post.data.updated)}</span>}
                          {post.data.pinned && <span class="meta-pill">Pinned</span>}
                        </div>
                        <div class="article-tags">
                          {post.data.tags.map((tag) => (
                            <a href={withBase(`blog/tag/${slugifyTaxonomy(tag)}/`)}>#{tag}</a>
                          ))}
                        </div>
                      </header>
                      {isServerRendered ? (
                        <div class="article-body" data-article-src={withBase(postRoute)} data-state="loaded" set:html={articleHtml} />
                      ) : (
                        <div class="article-body" data-article-src={withBase(postRoute)}>
                          <p class="article-loading">Loading…</p>
                        </div>
                      )}
                      <nav class="post-nav" aria-label="Post navigation" data-pagefind-ignore>
                        {previous ? (
                          <a href={withBase(`blog/${previous.id}/`)} data-portal-direction="back">
                            <span>Previous</span>
                            <strong>{previous.data.title}</strong>
                          </a>
                        ) : <span></span>}
                        {next ? (
                          <a href={withBase(`blog/${next.id}/`)} data-portal-direction="forward">
                            <span>Next</span>
                            <strong>{next.data.title}</strong>
                          </a>
                        ) : <span></span>}
                      </nav>
                      {post.data.comment && <Comments term={`blog/${post.id}`} />}
                    </div>
                    <aside class="toc-panel" aria-label="Table of contents" data-article-toc hidden></aside>
                  </div>
                </article>
              );
            })
          }

          <article
            class={`page detail-page ${panelState("search/").class}`}
            inert={panelState("search/").inert}
            data-panel="search"
            data-route="search/"
            data-search-root
            data-search-url={withBase("search-data.json")}
            data-base={base}
          >
            <a class="panel-back" href={withBase()} data-portal-route="">Back to dashboard</a>
            <div class="page-heading">
              <p>Search</p>
              <h2>Search blog inside the portal.</h2>
            </div>
            <input class="search-box portal-search-box" id="portal-search-box" type="search" placeholder="Type keywords..." autocomplete="off" />
            <section class="search-results" id="portal-search-results" aria-live="polite"></section>
          </article>

          {notFound && (
            <article
              class={`page detail-page not-found-page ${panelState(notFoundKey).class}`}
              inert={panelState(notFoundKey).inert}
              data-panel="not-found"
            >
              <div class="page-heading">
                <p>404</p>
                <h2>Page not found.</h2>
