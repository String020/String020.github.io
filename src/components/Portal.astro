    <div class="editor-toast" data-editor-toast hidden role="status"></div>
    <script id="portal-content-data" type="application/json" set:html={serializedPortalContent}></script>
    <CommentsScript />

    <script is:inline>
      const track = document.querySelector("[data-track]");
      // The portal is served at many routes now, so the site base comes from the build, not the URL.
      const basePath = document.body.dataset.portalBase || "/";
      let tabs = [];
      let panels = [];
      let pageCount = 1;
      let routeMap = new Map();

      function refreshPortalRouting() {
        tabs = Array.from(document.querySelectorAll("[data-page]"));
        panels = Array.from(document.querySelectorAll("[data-panel]"));
        pageCount = panels.length || 1;
        routeMap = new Map();
        track.style.setProperty("--page-count", String(pageCount));
        panels.forEach((panel, index) => {
          panel.dataset.panelIndex = String(index);
          const route = panel.dataset.route;
          if (route !== undefined) routeMap.set(route, panel.dataset.panel);
        });
        routeMap.set("/", "home");
        routeMap.set("", "home");
      }

      refreshPortalRouting();

      function normalizeRoute(url) {
        const parsed = new URL(url, window.location.href);
        if (parsed.origin !== window.location.origin) return null;
        let pathname = parsed.pathname;
        if (basePath !== "/" && pathname.startsWith(basePath)) {
          pathname = pathname.slice(basePath.length);
        }
        pathname = pathname.replace(/^\/+/, "");
        return pathname ? `${pathname.replace(/\/?$/, "/")}${parsed.search}` : "";
      }

      // Keep the active tab visible when the tab bar scrolls horizontally on narrow screens.
      function revealTab(tab) {
        const bar = tab.parentElement;
        if (!bar || bar.scrollWidth <= bar.clientWidth) return;
        const barRect = bar.getBoundingClientRect();
        const tabRect = tab.getBoundingClientRect();
        if (tabRect.left < barRect.left) bar.scrollLeft -= barRect.left - tabRect.left + 12;
        else if (tabRect.right > barRect.right) bar.scrollLeft += tabRect.right - barRect.right + 12;
      }

      const calloutPattern = /^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*/i;

      // Adds copy buttons, GitHub-style callouts and the table of contents to a loaded article body.
      function enhanceArticle(panel) {
        const body = panel?.querySelector('.article-body[data-state="loaded"]');
        if (!body || body.dataset.enhanced) return;
        body.dataset.enhanced = "true";

        body.querySelectorAll("pre").forEach((pre) => {
          const code = pre.querySelector("code");
          if (!code || pre.querySelector(".copy-code-button")) return;
          const button = document.createElement("button");
          button.className = "copy-code-button";
          button.type = "button";
          button.textContent = "Copy";
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(code.textContent || "");
              button.textContent = "Copied";
              window.setTimeout(() => {
                button.textContent = "Copy";
              }, 1200);
            } catch {
              button.textContent = "Failed";
            }
          });
          pre.appendChild(button);
        });

        body.querySelectorAll("blockquote").forEach((quote) => {
          const firstParagraph = quote.querySelector("p");
          const match = firstParagraph?.textContent?.match(calloutPattern);
          if (!match) return;
          const type = match[1].toLowerCase();
          quote.classList.add("callout", `callout-${type}`);
          const label = document.createElement("strong");
          label.className = "callout-label";
          label.textContent = type.toUpperCase();
          firstParagraph.textContent = firstParagraph.textContent.replace(calloutPattern, "");
          quote.prepend(label);
          if (!firstParagraph.textContent.trim()) firstParagraph.remove();
        });

        const toc = panel.querySelector("[data-article-toc]");
        const headings = Array.from(body.querySelectorAll("h2[id], h3[id]"));
        if (!toc || headings.length === 0) return;
        const heading = document.createElement("strong");
        heading.textContent = "Contents";
        toc.replaceChildren(heading);
        headings.forEach((item) => {
          const link = document.createElement("a");
          link.className = `depth-${item.tagName.slice(1)}`;
          link.href = `#${item.id}`;
          link.textContent = item.textContent;
          toc.appendChild(link);
        });
        toc.hidden = false;
        toc.closest(".article-layout")?.classList.add("has-toc");
      }

      // Bodies of other posts are fetched from that post's own page the first time its panel opens.
      function loadArticleBody(panel) {
        const body = panel?.querySelector("[data-article-src]");
        if (!body || body.dataset.state) return;
        body.dataset.state = "loading";
        fetch(body.dataset.articleSrc)
          .then((response) => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.text();
          })
          .then((html) => {
            const source = new DOMParser()
              .parseFromString(html, "text/html")
              .querySelector('.article-body[data-state="loaded"]');
            if (!source) throw new Error("Article body not found");
            body.replaceChildren(...source.childNodes);
            body.dataset.state = "loaded";
            enhanceArticle(panel);
          })
          .catch(() => {
            const message = document.createElement("p");
            message.className = "article-loading";
            const retry = document.createElement("a");
            retry.href = body.dataset.articleSrc;
            retry.textContent = "Try again";
            message.append("This post could not be loaded. ", retry);
            body.replaceChildren(message);
            delete body.dataset.state;
          });
      }

      // The stage follows the current panel's height instead of stretching to the tallest panel.
      let observedPanel = null;
      const stageResizeObserver = new ResizeObserver(() => syncStageHeight());

      function syncStageHeight() {
        if (observedPanel) track.style.height = `${observedPanel.offsetHeight}px`;
      }

      function observeCurrentPanel(panel) {
        if (panel !== observedPanel) {
          if (observedPanel) stageResizeObserver.unobserve(observedPanel);
          observedPanel = panel || null;
          if (observedPanel) stageResizeObserver.observe(observedPanel);
        }
        syncStageHeight();
      }

      const stage = document.querySelector(".content-stage");
      const portalHeader = document.querySelector(".portal-header");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // After a visitor switches panels, bring the panel top into view when it sits off-screen,
      // such as below the profile cards on phones or after scrolling down a long panel.
      function revealStage() {
        const offset = (portalHeader?.offsetHeight || 0) + 12;
        const top = stage.getBoundingClientRect().top;
        if (top >= offset && top <= window.innerHeight * 0.4) return;
        window.scrollTo({ top: window.scrollY + top - offset, behavior: reduceMotion ? "auto" : "smooth" });
      }

      const panelDirections = { back: -1, forward: 1 };

      // Top-level panels (dashboard, BLOG and navigation sections) sit above detail panels.
      const panelDepth = (panel) => (panel.classList.contains("detail-page") ? 1 : 0);
      const panelTab = (panel) => (panel.dataset.tab !== undefined ? Number(panel.dataset.tab) : 0);

      // -1 enters from the left (going back), 1 from the right (going deeper or forward), 0 just fades.
      function transitionDirection(fromPanel, toPanel, hint) {
        if (hint in panelDirections) return panelDirections[hint];
        if (!fromPanel || !toPanel) return 0;
        const fromDepth = panelDepth(fromPanel);
        const toDepth = panelDepth(toPanel);
        if (fromDepth !== toDepth) return toDepth > fromDepth ? 1 : -1;
        if (toDepth === 0) return Math.sign(panelTab(toPanel) - panelTab(fromPanel));
        return 0;
      }

      // The track jumps straight to the new panel; only the incoming panel eases in, so switching
      // between distant panels never sweeps the whole track past the viewer.
      function animatePanelIn(panel, direction) {
        if (reduceMotion || !panel.animate) return;
        panel.animate(
          [
            { opacity: 0, transform: `translateX(${direction * 28}px)` },
            { opacity: 1, transform: "translateX(0)" },
          ],
          { duration: 300, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
        );
      }

      function setActivePage(index, pushRoute = null, hint = null) {
        const pageIndex = Number(index);
        const previousPanel = panels.find((panel) => panel.classList.contains("is-current"));
        track.style.transform = `translateX(calc(-${pageIndex} * 100% / ${pageCount}))`;

        const activePanel = panels[pageIndex];
        if (activePanel && previousPanel && activePanel !== previousPanel) {
          animatePanelIn(activePanel, transitionDirection(previousPanel, activePanel, hint));
        }
        loadArticleBody(activePanel);
        window.portalComments?.mount(activePanel?.querySelector("[data-comments]"));
        if (activePanel?.dataset.panel === "search") loadSearchEngine();
        const activeTab = activePanel?.dataset.tab ? Number(activePanel.dataset.tab) : pageIndex;

        tabs.forEach((tab, currentIndex) => {
          const isActive = currentIndex === activeTab;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-current", String(isActive));
          if (isActive) revealTab(tab);
        });

        panels.forEach((panel, currentIndex) => {
          const isCurrent = currentIndex === pageIndex;
          panel.classList.toggle("is-current", isCurrent);
          // Off-screen panels stay out of the keyboard and screen reader order.
          panel.inert = !isCurrent;
        });
        observeCurrentPanel(activePanel);

        if (pushRoute !== null) {
          const routeUrl = new URL(pushRoute || ".", window.location.origin + basePath);
          window.history.pushState({ panel: activePanel?.dataset.panel }, "", routeUrl);
        }
      }

      function openPanel(panelName, pushRoute = null, hint = null) {
        const panel = panels.find((item) => item.dataset.panel === panelName);
        if (!panel) return false;
        setActivePage(Number(panel.dataset.panelIndex), pushRoute, hint);
        return true;
      }

      // Opens the panel for the current address. Addresses without a portal route only reach the
      // portal through the 404 page, which opens its own panel instead of the dashboard.
      function openLocation() {
        const route = normalizeRoute(window.location.href);
        if (route && openRoute(route, false)) return;
        const fallbackPanel = document.body.dataset.initialPanel;
        if (!(route && fallbackPanel && openPanel(fallbackPanel))) setActivePage(0);
      }

      function openRoute(route, push = true, hint = null) {
        const [cleanRoute, query = ""] = route.split("?");
        const panelName = routeMap.get(cleanRoute);
        if (!panelName) return false;
        const isSearch = panelName === "search";
        openPanel(panelName, push ? (isSearch ? route : cleanRoute) : null, hint);
        if (isSearch) setSearchQuery(new URLSearchParams(query).get("q") || "");
        return true;
      }

      // Scrolls to an element inside the current panel, clearing the fixed header.
      function scrollToTarget(target, behavior = "auto") {
        const offset = (portalHeader?.offsetHeight || 0) + 16;
        window.scrollTo({ top: window.scrollY + target.getBoundingClientRect().top - offset, behavior });
      }

      function findInCurrentPanel(hash) {
        const id = decodeURIComponent(hash.replace(/^#/, ""));
        const panel = panels.find((item) => item.classList.contains("is-current"));
        return id && panel ? panel.querySelector(`[id="${CSS.escape(id)}"]`) : null;
      }

      const labMenu = document.querySelector("[data-lab-menu]");
      const labMenuToggle = labMenu?.querySelector("[data-lab-menu-toggle]");
      const labMenuPanel = labMenu?.querySelector("[data-lab-menu-panel]");
      const labTreeTriggers = Array.from(labMenu?.querySelectorAll("[data-lab-tree-trigger]") || []);
      const labBranchBacks = Array.from(labMenu?.querySelectorAll("[data-lab-branch-back]") || []);
      const labLayerTimers = new WeakMap();
      const labReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function clearLabLayerTimer(layer) {
        const timer = labLayerTimers.get(layer);
        if (timer) window.clearTimeout(timer);
        labLayerTimers.delete(layer);
      }

      function showLabLayer(layer) {
        if (!layer) return;
        clearLabLayerTimer(layer);
        layer.hidden = false;
        layer.dataset.state = "opening";
        if (labReduceMotion) {
          layer.dataset.state = "open";
          return;
        }
        layer.getBoundingClientRect();
        layer.dataset.state = "open";
      }

      function hideLabLayer(layer) {
        if (!layer || layer.hidden || layer.dataset.state === "closing") return;
        clearLabLayerTimer(layer);
        layer.dataset.state = "closing";
        const finish = () => {
          if (layer.dataset.state !== "closing") return;
          layer.hidden = true;
          layer.removeAttribute("data-state");
          labLayerTimers.delete(layer);
        };
        if (labReduceMotion) {
          finish();
          return;
        }
        labLayerTimers.set(layer, window.setTimeout(finish, 240));
      }

      function collapseLabBranches(exceptTrigger = null) {
        labTreeTriggers.forEach((trigger) => {
          if (trigger === exceptTrigger) return;
          trigger.setAttribute("aria-expanded", "false");
          const branchId = trigger.getAttribute("aria-controls");
          const branch = branchId ? document.getElementById(branchId) : null;
          hideLabLayer(branch);
        });
      }

      function setLabMenuOpen(open, returnFocus = false) {
        if (!labMenuToggle || !labMenuPanel) return;
        labMenuToggle.setAttribute("aria-expanded", String(open));
        labMenu.classList.toggle("is-open", open);
        if (open) showLabLayer(labMenuPanel);
        else hideLabLayer(labMenuPanel);
        if (!open) {
          collapseLabBranches();
          if (returnFocus) labMenuToggle.focus();
        }
      }

      labMenuToggle?.addEventListener("click", () => {
        setLabMenuOpen(labMenuToggle.getAttribute("aria-expanded") !== "true");
      });

      labTreeTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const willOpen = trigger.getAttribute("aria-expanded") !== "true";
          collapseLabBranches(trigger);
          trigger.setAttribute("aria-expanded", String(willOpen));
          const branchId = trigger.getAttribute("aria-controls");
          const branch = branchId ? document.getElementById(branchId) : null;
          if (willOpen) showLabLayer(branch);
          else hideLabLayer(branch);
        });
      });

      labBranchBacks.forEach((backButton) => {
        backButton.addEventListener("click", () => {
          const branch = backButton.closest("[data-lab-tree-branch]");
          const trigger = branch?.id
            ? labTreeTriggers.find((item) => item.getAttribute("aria-controls") === branch.id)
            : null;
          hideLabLayer(branch);
          if (trigger) {
            trigger.setAttribute("aria-expanded", "false");
            trigger.focus();
          }
        });
      });

      const themeToggle = document.querySelector("[data-theme-toggle]");

      function syncThemeToggle() {
        themeToggle?.setAttribute("aria-checked", String(document.documentElement.dataset.theme === "dark"));
      }

      themeToggle?.addEventListener("click", () => {
        window.portalTheme?.set(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
      });
      window.addEventListener("portal-themechange", syncThemeToggle);
      syncThemeToggle();

      document.addEventListener("click", (event) => {
        if (labMenu && !labMenu.contains(event.target)) {
          setLabMenuOpen(false);
        }

        const tab = event.target.closest("[data-page]");
        if (tab) {
          // Tabs update the address too, so a reload or shared link reopens the same section.
          const tabPanel = panels[Number(tab.dataset.page)];
          const isAlreadyOpen = tabPanel?.classList.contains("is-current");
          setActivePage(tab.dataset.page, isAlreadyOpen ? null : tabPanel?.dataset.route ?? null);
          revealStage();
          return;
        }

        const link = event.target.closest("a[href]");
        if (!link || link.target || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        // Same-page anchors such as table-of-contents links scroll within the current panel.
        const linkUrl = new URL(link.href, window.location.href);
        if (linkUrl.hash && linkUrl.origin === window.location.origin && linkUrl.pathname === window.location.pathname) {
          const target = findInCurrentPanel(linkUrl.hash);
          if (target) {
            event.preventDefault();
            scrollToTarget(target, reduceMotion ? "auto" : "smooth");
            window.history.replaceState(window.history.state, "", linkUrl);
          }
          return;
        }

        const route = link.dataset.portalRoute ?? normalizeRoute(link.href);
        if (route === null) return;
        if (openRoute(route, true, link.dataset.portalDirection)) {
          event.preventDefault();
          setLabMenuOpen(false);
          revealStage();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && labMenuToggle?.getAttribute("aria-expanded") === "true") {
          const expandedTrigger = labTreeTriggers.find((trigger) => trigger.getAttribute("aria-expanded") === "true");
          if (expandedTrigger) {
            collapseLabBranches();
            expandedTrigger.focus();
          } else {
            setLabMenuOpen(false, true);
          }
        }
      });

      window.addEventListener("popstate", openLocation);

      const searchRoot = document.querySelector("[data-search-root]");
      const searchInput = document.getElementById("portal-search-box");
      const searchResults = document.getElementById("portal-search-results");
      const searchUrl = searchRoot?.dataset.searchUrl || `${basePath}search-data.json`;

      const withPortalBase = (path) => `${basePath}${String(path).replace(/^\/+/, "")}`;
      const normalizeText = (value) => String(value || "").toLowerCase();

      // Fallback for `astro dev`, where the Pagefind index has not been built: match the post list.
      function findBasicMatches(posts, query) {
        const terms = normalizeText(query).split(/\s+/).filter(Boolean);
        return posts
          .filter((post) => {
            const haystack = normalizeText([post.title, post.description, post.category, ...(post.tags || []), post.excerpt].join(" "));
            return terms.every((term) => haystack.includes(term));
          })
          .map((post) => ({
            url: withPortalBase(post.url),
            title: post.title,
            meta: `${post.category} / ${post.reading}`,
            excerptText: post.description || post.excerpt || "",
          }));
      }

      let searchEngine = null;

      // The full-text index loads only once a visitor opens search, not on every page view.
      function loadSearchEngine() {
        searchEngine ??= import(`${basePath}pagefind/pagefind.js`)
          .then(async (pagefind) => {
            await pagefind.options({ excerptLength: 26 });
            return {
              async search(query) {
                const response = await pagefind.search(query);
                const results = await Promise.all(response.results.slice(0, 20).map((result) => result.data()));
                return results.map((result) => ({
                  url: result.url,
                  title: result.meta.title,
                  meta: [result.meta.category, result.meta.reading].filter(Boolean).join(" / "),
                  excerptHtml: result.excerpt,
                }));
              },
            };
          })
          .catch(() =>
            fetch(searchUrl)
              .then((response) => response.json())
              .then((posts) => ({ search: async (query) => findBasicMatches(Array.isArray(posts) ? posts : [], query) })),
          );
        return searchEngine;
      }

      function renderSearchMessage(text) {
        const message = document.createElement("p");
        message.className = "search-empty";
        message.textContent = text;
        searchResults?.replaceChildren(message);
      }

      function renderPortalSearch(items) {
        if (!searchResults) return;
        if (items.length === 0) {
          renderSearchMessage("No matching posts found yet.");
          return;
        }
        searchResults.replaceChildren(
          ...items.map((item) => {
            const card = document.createElement("article");
            card.className = "search-result-card";

            const title = document.createElement("a");
            title.className = "post-title-link";
            title.href = item.url;
            title.textContent = item.title;

            const meta = document.createElement("small");
            meta.textContent = item.meta;

            const excerpt = document.createElement("p");
            // Pagefind excerpts are escaped page text with <mark> around the matched words.
            if (item.excerptHtml) excerpt.innerHTML = item.excerptHtml;
            else excerpt.textContent = item.excerptText;

            card.append(title, meta, excerpt);
            return card;
          }),
        );
      }

      let searchRun = 0;

      async function runPortalSearch(query) {
        const run = ++searchRun;
        const trimmed = query.trim();
        if (!trimmed) {
          renderSearchMessage("Type keywords to search posts.");
          return;
        }
        try {
          const engine = await loadSearchEngine();
          const items = await engine.search(trimmed);
          if (run === searchRun) renderPortalSearch(items);
        } catch {
          if (run === searchRun) renderSearchMessage("Search index failed to load.");
        }
      }

      function setSearchQuery(query) {
        if (!searchInput) return;
        searchInput.value = query;
        runPortalSearch(query);
      }

      renderSearchMessage("Type keywords to search posts.");
      searchInput?.addEventListener("focus", loadSearchEngine, { once: true });

      searchInput?.addEventListener("input", () => {
        runPortalSearch(searchInput.value);
        // Keep the query in the address bar so a search can be shared or reloaded.
        if (!searchRoot?.classList.contains("is-current")) return;
        const url = new URL(window.location.href);
        const query = searchInput.value.trim();
        if (query) url.searchParams.set("q", query);
        else url.searchParams.delete("q");
        window.history.replaceState(window.history.state, "", url);
      });

      const missingPath = document.querySelector("[data-missing-path]");
      if (missingPath) {
        missingPath.textContent = decodeURIComponent(window.location.pathname);
        missingPath.hidden = false;
      }
      document.querySelector("[data-not-found-search]")?.addEventListener("submit", (event) => {
        const query = new FormData(event.currentTarget).get("q")?.toString().trim() || "";
        if (openRoute(query ? `search/?q=${encodeURIComponent(query)}` : "search/")) event.preventDefault();
      });

      // Open the panel for the URL this page was served at; the server already rendered it as current.
      openLocation();
      document.querySelectorAll(".article-panel").forEach(enhanceArticle);
      // Anchor jumps can scroll the clipped stage sideways; keep it aligned with the track.
      stage.scrollLeft = 0;
      if (window.location.hash) {
        const target = findInCurrentPanel(window.location.hash);
        if (target) requestAnimationFrame(() => scrollToTarget(target));
      }
      window.portalRouter = { refresh: refreshPortalRouting, openPanel, openRoute, setActivePage };

      // Only signed-in administrators need the editor, so visitors never download it.
      let hasAdminSession = false;
      try {
        hasAdminSession = Boolean(
          sessionStorage.getItem("portal-admin-token") || sessionStorage.getItem("portal-local-admin"),
        );
      } catch {}
      if (hasAdminSession || /(^|[#&])admin_token=/.test(window.location.hash)) {
        const editorScript = document.createElement("script");
        editorScript.type = "module";
        editorScript.src = document.body.dataset.editorSrc;
        document.body.appendChild(editorScript);
      }
    </script>
  </body>
</html>
