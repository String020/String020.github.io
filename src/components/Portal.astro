                <a class="tool-link" href={withBase()}>Dashboard</a>
                <a class="tool-link" href={withBase("blog/")}>Blog</a>
                <a class="tool-link" href={withBase("search/")}>Search</a>
              </nav>
            </article>
          )}
        </div>
      </section>
    </main>

