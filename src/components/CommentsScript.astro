---
// Loads Giscus into [data-comments] containers and keeps its theme in sync with the site theme.
---

<script is:inline>
  (() => {
    const giscusOrigin = "https://giscus.app";
    // Each container carries absolute URLs for the site's own light and dark giscus themes.
    const giscusTheme = (container, theme) =>
      theme === "dark" ? container.dataset.themeDark : container.dataset.themeLight;

    function mount(container) {
      if (!container || container.dataset.commentsMounted) return;
      container.dataset.commentsMounted = "true";
      const { repo, repoId, category, categoryId, term } = container.dataset;
      const config = {
        repo,
        "repo-id": repoId,
        category,
        "category-id": categoryId,
        mapping: "specific",
        term,
        strict: "1",
        "reactions-enabled": "1",
        "emit-metadata": "0",
        "input-position": "bottom",
        theme: giscusTheme(container, document.documentElement.dataset.theme),
        lang: "zh-CN",
        loading: "lazy",
      };
      const script = document.createElement("script");
      script.src = `${giscusOrigin}/client.js`;
      script.async = true;
      script.crossOrigin = "anonymous";
      Object.entries(config).forEach(([name, value]) => script.setAttribute(`data-${name}`, value));
      container.append(script);
    }

    window.addEventListener("portal-themechange", (event) => {
      document.querySelectorAll("[data-comments-mounted]").forEach((container) => {
        const message = { giscus: { setConfig: { theme: giscusTheme(container, event.detail.theme) } } };
        container.querySelector("iframe.giscus-frame")?.contentWindow?.postMessage(message, giscusOrigin);
      });
    });

    window.portalComments = { mount };
    document.querySelectorAll("[data-comments][data-comments-autoload]").forEach(mount);
  })();
</script>
